# Postgres URL. Local: postgresql+psycopg://archie:archie@127.0.0.1:5434/archie. Railway sets its own.
DATABASE_URL=
# Comma-separated emails whose accounts use the owner's API keys.
OWNER_EMAILS=
# The app's bundle id; Apple identity tokens must name it as their audience.
APPLE_AUDIENCE=com.sampocs.archie
# prod, dev or test. Test-only routes exist only when this is set to dev or test; leave it unset or prod in production.
ARCHIE_ENV=dev
# Tests only: the throwaway test database (`make test-db` sets this for you).
TEST_DATABASE_URL=
# Anthropic API key for the worker's analyze and primer steps (summaries, primers, cards).
ANTHROPIC_API_KEY=
